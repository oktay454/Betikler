#!/bin/bash
set -Eeuo pipefail
# DNS-01 değerleri ASCII kullanır; Türkçe yerel ayarı aralıkları etkilememeli.
export LC_ALL=C
SCRIPT_NAME="${0##*/}"

function ExitError()
{
	# Komut metni API anahtarlarını içerebileceğinden günlüğe yazılmaz.
	printf '%s: %s. satırda hata (çıkış kodu: %s).\n' "${SCRIPT_NAME}" "$1" "$2" >&2
}

function Fail()
{
	printf '%s: %s\n' "${SCRIPT_NAME}" "$1" >&2
	exit 1
}

function Usage()
{
	cat <<USAGE
İlkbyte DNS-01 doğrulama kaydını ekler veya yalnızca belirtilen değeri siler.

Kullanımı
=========
-r => add|delete (Zorunlu)
-d => DNS bölgesi; varsayılan CERTBOT_DOMAIN
-s => Bölge içindeki alt alan adı (İsteğe bağlı)
-v => TXT değeri; varsayılan CERTBOT_VALIDATION (Her iki işlem için zorunlu)
-w => DNS yayılımını bekle (Certbot kancasında kendiliğinden etkin)
-t => Eski TTL seçeneği; API desteklemediğinden kullanılmaz

Anahtarlar: /etc/default/certbot-ilkbyte-dns01 içinde ACCESS_KEY ve SECRET_KEY.
Bekleme: WAIT_ATTEMPTS=30, WAIT_INTERVAL=10; isteğe bağlı DNS_SERVER.
Varsayılan olarak bölgenin tüm yetkili ad sunucuları sorgulanır.
Alt alan adı için -d ile bölgeyi, -s ile alt alanı belirtin.

Örnekler
=========
${SCRIPT_NAME} -r add -d "falanca.com" -v "TXT_DEGERI" -w
${SCRIPT_NAME} -r delete -d "falanca.com" -v "TXT_DEGERI"
certbot certonly --manual --preferred-challenges dns \
  -d "falanca.com" -d "*.falanca.com" \
  --manual-auth-hook "${SCRIPT_NAME} -r add" \
  --manual-cleanup-hook "${SCRIPT_NAME} -r delete"
USAGE
}

function Api()
{
	local ACTION="$1"
	local RESPONSE
	shift
	if ! RESPONSE="$(curl --silent --show-error --fail --get \
		--connect-timeout 10 --max-time 60 \
		--header 'accept: application/json' \
		--data-urlencode "access=${ACCESS_KEY}" \
		--data-urlencode "secret=${SECRET_KEY}" \
		"${API_URL}/${DOMAIN}/${ACTION}" "$@")"
	then
		Fail "API ${ACTION} isteği başarısız; bağlantıyı, HTTP durumunu ve API erişim izinlerini kontrol edin."
	fi
	if ! jq -e 'type == "object" and .status == true' >/dev/null 2>&1 <<< "${RESPONSE}"
	then
		local MESSAGE
		MESSAGE="$(jq -r '(.error // .message // "Geçersiz API yanıtı") | tostring' <<< "${RESPONSE}" 2>/dev/null || true)"
		MESSAGE="${MESSAGE//"${ACCESS_KEY}"/[GIZLENDI]}"
		MESSAGE="${MESSAGE//"${SECRET_KEY}"/[GIZLENDI]}"
		Fail "API ${ACTION} işlemi başarısız: ${MESSAGE:-JSON yanıtı alınamadı}"
	fi
	printf '%s\n' "${RESPONSE}"
}

function Find()
{
	local RESPONSE
	RESPONSE="$(Api show)" || return 1
	jq -e '.data.Records | type == "array"' >/dev/null <<< "${RESPONSE}" || Fail "API kayıt listesi geçersiz."
	jq -r --arg NAME "${RECORD_NAME}" --arg VALUE "${TXT_RECORD}" '
		.data.Records[] |
		select(.Type == "TXT" and .Name == $NAME) |
		select(.Content == $VALUE or .Content == ("\"" + $VALUE + "\"")) |
		.Id
	' <<< "${RESPONSE}"
}

function Delete()
{
	local IDS ID
	IDS="$(Find)" || return 1
	[[ -n "${IDS}" ]] || return 0
	while IFS= read -r ID
	do
		[[ "${ID}" =~ ^[0-9]+$ ]] || Fail "API geçersiz kayıt kimliği döndürdü."
		Api delete --data-urlencode "record_id=${ID}" >/dev/null
	done <<< "${IDS}"
	Api push >/dev/null
}

function Add()
{
	local IDS
	IDS="$(Find)" || return 1
	# Aynı isimdeki diğer doğrulama değerlerini koru (ana alan adı + yıldız).
	if [[ -z "${IDS}" ]]
	then
		Api add \
			--data-urlencode "record_name=${RECORD_NAME}" \
			--data-urlencode 'record_type=TXT' \
			--data-urlencode 'record_priority=0' \
			--data-urlencode "record_content=\"${TXT_RECORD}\"" >/dev/null
	fi
	# Önceki bir push başarısız olmuşsa tekrar çağrı da kaydı yayımlamalı.
	Api push >/dev/null
}

function WaitForProcessing()
{
	[[ "${VERB}" == "add" && "${WAIT_FOR_PROCESSING}" == "true" ]] || return 0
	local SERVERS SERVER ANSWERS ATTEMPT ALL_READY
	if [[ -n "${DNS_SERVER}" ]]
	then
		SERVERS="${DNS_SERVER}"
	else
		SERVERS="$(dig +short +time=3 +tries=1 NS "${DOMAIN}.")"
	fi
	[[ -n "${SERVERS}" ]] || Fail "Yetkili DNS sunucuları bulunamadı."
	printf '%s: %s DNS yayılımı bekleniyor.\n' "${SCRIPT_NAME}" "${RECORD_NAME}.${DOMAIN}" >&2
	for ((ATTEMPT=1; ATTEMPT<=WAIT_ATTEMPTS; ATTEMPT++))
	do
		ALL_READY="true"
		for SERVER in ${SERVERS}
		do
			if ! ANSWERS="$(dig +short +time=3 +tries=1 TXT "${RECORD_NAME}.${DOMAIN}." "@${SERVER}")"
			then
				ALL_READY="false"
				continue
			fi
			# Birden fazla TXT yanıtının tamamını kontrol et.
			if ! tr -d '\"' <<< "${ANSWERS}" | grep -Fxq -- "${TXT_RECORD}"
			then
				ALL_READY="false"
			fi
		done
		if [[ "${ALL_READY}" == "true" ]]
		then
			return 0
		fi
		if (( ATTEMPT < WAIT_ATTEMPTS ))
		then
			sleep "${WAIT_INTERVAL}"
		fi
	done
	Fail "DNS yayılımı zaman aşımına uğradı: ${RECORD_NAME}.${DOMAIN}"
}

trap 'ExitError "${LINENO}" "$?"' ERR

ACCESS_KEY="${ACCESS_KEY:-}"
SECRET_KEY="${SECRET_KEY:-}"
ENVIRONMENT_FILE="${ENVIRONMENT_FILE:-/etc/default/certbot-ilkbyte-dns01}"
API_URL="https://api.ilkbyte.com/domain/manage"
DNS_SERVER=""
WAIT_FOR_PROCESSING="false"
WAIT_ATTEMPTS="30"
WAIT_INTERVAL="10"
DOMAIN="${CERTBOT_DOMAIN:-}"
TXT_RECORD="${CERTBOT_VALIDATION:-}"
SUBDOMAIN=""
VERB=""
if [[ -r "${ENVIRONMENT_FILE}" ]]
then
	# shellcheck source=/dev/null
	source "${ENVIRONMENT_FILE}"
fi
if [[ -n "${CERTBOT_VALIDATION:-}" ]]
then
	WAIT_FOR_PROCESSING="true"
fi

while getopts "hr:d:s:v:t:w" OPTION
do
	case "${OPTION}" in
		h)
			Usage
			exit 0
			;;
		r)
			VERB="${OPTARG,,}"
			;;
		d)
			DOMAIN="${OPTARG}"
			;;
		s)
			SUBDOMAIN="${OPTARG}"
			;;
		v)
			TXT_RECORD="${OPTARG}"
			;;
		t)
			printf '%s: -t kullanılmıyor; İlkbyte API TTL parametresi sunmuyor.\n' "${SCRIPT_NAME}" >&2
			;;
		w)
			WAIT_FOR_PROCESSING="true"
			;;
		*)
			Usage
			exit 2
			;;
	esac
done
shift "$((OPTIND - 1))"
[[ "$#" -eq 0 ]] || Fail "Beklenmeyen bağımsız değişken."
[[ "${VERB}" == "add" || "${VERB}" == "delete" ]] || Fail "-r add veya -r delete gerekli."
DOMAIN="${DOMAIN#\*.}"
DOMAIN="${DOMAIN%.}"
DOMAIN="${DOMAIN,,}"
[[ "${DOMAIN}" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]] || Fail "Geçerli bir DNS bölgesi gerekli."
[[ -z "${SUBDOMAIN}" || "${SUBDOMAIN}" =~ ^[a-zA-Z0-9_][a-zA-Z0-9_.-]*$ ]] || Fail "Geçersiz alt alan adı."
[[ "${TXT_RECORD}" =~ ^[a-zA-Z0-9_-]+$ ]] || Fail "DNS-01 TXT değeri gerekli (-v veya CERTBOT_VALIDATION)."
[[ -n "${ACCESS_KEY}" && -n "${SECRET_KEY}" ]] || Fail "ACCESS_KEY ve SECRET_KEY yapılandırılmalı."
[[ "${WAIT_FOR_PROCESSING}" == "true" || "${WAIT_FOR_PROCESSING}" == "false" ]] || Fail "WAIT_FOR_PROCESSING true veya false olmalı."
[[ "${WAIT_ATTEMPTS}" =~ ^[1-9][0-9]*$ && "${WAIT_INTERVAL}" =~ ^[1-9][0-9]*$ ]] || Fail "Bekleme ayarları pozitif tamsayı olmalı."
for DEPENDENCY in curl jq
do
	command -v "${DEPENDENCY}" >/dev/null || Fail "Eksik bağımlılık: ${DEPENDENCY}"
done
if [[ "${VERB}" == "add" && "${WAIT_FOR_PROCESSING}" == "true" ]]
then
	command -v dig >/dev/null || Fail "Eksik bağımlılık: dig (Debian paketi: bind9-dnsutils)"
fi
RECORD_NAME="_acme-challenge${SUBDOMAIN:+.${SUBDOMAIN}}"

case "${VERB}" in
	add)
		Add
		;;
	delete)
		Delete
		;;
esac
WaitForProcessing
